{
  "name": "hausplaner",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  // Wird einmal beim Erstellen des Codespace ausgeführt.
  // Claude Code wird als globales npm-Paket installiert, damit es ohne
  // PATH-Bastelei sofort verfügbar ist. Die npm-Variante installiert dasselbe
  // native Binary wie der Standalone-Installer.
  // Alternative, falls npm Probleme macht:
  //   curl -fsSL https://claude.ai/install.sh | bash
  //   (danach ggf. export PATH="$HOME/.local/bin:$PATH")
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && if [ -f package.json ]; then npm install; fi",

  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Vite Devserver", "onAutoForward": "openPreview" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vitest.explorer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}
